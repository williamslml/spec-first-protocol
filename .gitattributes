# Finales de línea fijos: los scripts se ejecutan también con el sh/bash de Linux/WSL.
*.sh   text eol=lf
*.py   text eol=lf
*.ps1  text eol=crlf
*.md   text
*.json text
# Copias de terceros: byte a byte, sin conversión de finales de línea (sus huellas están en vendor/README.md).
references/vendor/addyosmani-agent-skills/*.md -text
references/vendor/0xbigboss-claude-code/*.md -text

# El ejemplo debe tener siempre el mismo contenido byte a byte, porque el manifiesto guarda huellas.
examples/** text eol=lf
