{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-setup/manifest.schema.json",
  "title": "Manifiesto de project-setup (.sfp/manifest.json)",
  "description": "Formato normativo del manifiesto (schema 2). templates.md sección 1 es la plantilla comentada; este archivo manda si difieren. scripts/manifest_tool.py check lo valida (más las reglas entre campos que JSON Schema no expresa).",
  "type": "object",
  "required": ["schema", "tool", "skill_version", "installed_at", "source_methodology", "classification", "backup", "actions"],
  "additionalProperties": false,
  "properties": {
    "schema": { "enum": [1, 2] },
    "tool": { "const": "project-setup" },
    "skill_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "installed_at": { "$ref": "#/$defs/date" },
    "updated_at": { "$ref": "#/$defs/date" },
    "source_methodology": {
      "type": "object",
      "required": ["variant", "methodology"],
      "additionalProperties": false,
      "properties": {
        "variant": { "enum": ["con-orquestador", "sin-orquestador"] },
        "methodology": { "const": "SFP" },
        "version_or_hash": { "type": "string" }
      }
    },
    "classification": {
      "type": "object",
      "required": ["project_state", "intrusion", "orchestration"],
      "additionalProperties": false,
      "properties": {
        "project_state": { "enum": ["nuevo", "existente"] },
        "intrusion": { "enum": ["solo-metodologia", "integrar", "reestructurar", "n/a"] },
        "orchestration": { "type": "string", "minLength": 1 },
        "orchestrator_profile": { "$ref": "#/$defs/orchestrator_profile" }
      }
    },
    "spec_layer": {
      "type": "object",
      "required": ["tool"],
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "verified_at": { "$ref": "#/$defs/date" },
        "source": { "type": "string" },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "changes": { "type": "string" }, "proposal": { "type": "string" }, "requirements": { "type": "string" },
            "design": { "type": "string" }, "tasks": { "type": "string" }, "archive": { "type": "string" },
            "current_specs": { "type": "string" }
          }
        }
      }
    },
    "product": {
      "type": "object",
      "required": ["name", "role", "repos"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "coordination": { "type": "string" },
        "repos": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["name", "role"], "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "location": { "type": "string" }, "role": { "type": "string" } }
          }
        }
      }
    },
    "runtimes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "backup": {
      "type": "object",
      "required": ["type", "ref"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["git-tag", "git-branch", "copia", "ninguno"] },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "structure": {
      "type": "object",
      "required": ["profile"],
      "additionalProperties": false,
      "properties": {
        "profile": { "$ref": "#/$defs/profile" },
        "stage": { "$ref": "#/$defs/stage" },
        "rationale": { "type": "string" },
        "verify_command": { "type": "string" },
        "workspaces": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "profile", "stage"],
            "additionalProperties": false,
            "properties": {
              "path": { "$ref": "#/$defs/relpath" },
              "profile": { "$ref": "#/$defs/profile" },
              "stage": { "$ref": "#/$defs/stage" },
              "rationale": { "type": "string" },
              "verify_command": { "type": "string" }
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "type": { "enum": ["create", "merge", "move", "configure"] },
          "path": { "$ref": "#/$defs/relpath" },
          "from": { "$ref": "#/$defs/relpath" },
          "markers": { "type": "boolean" },
          "sha256": { "type": "string", "pattern": "^([0-9a-f]{64})?$" },
          "format": { "enum": ["json"] },
          "changes": { "type": "array", "items": { "$ref": "#/$defs/json_change" } },
          "runtime": { "type": "string" },
          "risk": { "enum": ["bajo", "medio", "alto"] },
          "reversible": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "relpath": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!(.*/)?\\.\\.(/|$)).+$" },
    "profile": { "enum": ["api", "frontend", "fullstack", "monorepo", "libreria-sdk", "datos-ml", "movil", "infra", "ninguno"] },
    "stage": { "enum": ["1", "2", "n/a", 1, 2] },
    "area": {
      "type": "object",
      "required": ["estado", "resumen", "fuente", "fecha"],
      "additionalProperties": false,
      "properties": {
        "estado": { "enum": ["verificado", "parcial", "PENDIENTE", "n/a"] },
        "resumen": { "type": "string" },
        "fuente": { "type": "string" },
        "fecha": { "anyOf": [{ "$ref": "#/$defs/date" }, { "const": "" }] }
      }
    },
    "orchestrator_profile": {
      "type": "object",
      "required": ["name", "verified_at", "areas"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "verified_at": { "$ref": "#/$defs/date" },
        "areas": {
          "type": "object",
          "required": ["identidad", "instalacion", "runtimes", "modelo_agentes", "coordinacion", "permisos_aislamiento", "aprobacion_humana", "memoria", "estado_specs", "git_concurrencia", "configuracion", "observabilidad", "privacidad_red", "limitaciones", "salida"],
          "additionalProperties": false,
          "properties": {
            "identidad": { "$ref": "#/$defs/area" }, "instalacion": { "$ref": "#/$defs/area" }, "runtimes": { "$ref": "#/$defs/area" },
            "modelo_agentes": { "$ref": "#/$defs/area" }, "coordinacion": { "$ref": "#/$defs/area" }, "permisos_aislamiento": { "$ref": "#/$defs/area" },
            "aprobacion_humana": { "$ref": "#/$defs/area" }, "memoria": { "$ref": "#/$defs/area" }, "estado_specs": { "$ref": "#/$defs/area" },
            "git_concurrencia": { "$ref": "#/$defs/area" }, "configuracion": { "$ref": "#/$defs/area" }, "observabilidad": { "$ref": "#/$defs/area" },
            "privacidad_red": { "$ref": "#/$defs/area" }, "limitaciones": { "$ref": "#/$defs/area" }, "salida": { "$ref": "#/$defs/area" }
          }
        },
        "compensations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "json_change": {
      "type": "object",
      "required": ["pointer", "op"],
      "additionalProperties": false,
      "properties": {
        "pointer": { "type": "string", "pattern": "^(/.*)?$" },
        "op": { "enum": ["add", "replace", "remove", "append"] },
        "before": {},
        "after": {},
        "items": { "type": "array" }
      }
    }
  }
}
